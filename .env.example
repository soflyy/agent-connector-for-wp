# Site password gate
# SITE_PASSWORD — the password users must enter
# AUTH_TOKEN_HASH — any random secret string (used as the cookie value)
#   Generate one: openssl rand -hex 32
SITE_PASSWORD=
AUTH_TOKEN_HASH=

# Vercel KV — add these from your Vercel dashboard (Storage → KV → .env.local)
# Without these, the app falls back to static seed data (read-only, no submissions)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protect the seed and admin API routes
SEED_SECRET=
ADMIN_SECRET=
