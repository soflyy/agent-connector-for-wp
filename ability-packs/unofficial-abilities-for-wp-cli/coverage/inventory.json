{
  "plugin": {
    "slug": "wp-cli",
    "version": "2.12.0",
    "main_file": "(none — target is WP-CLI itself against WordPress core, not a plugin)",
    "notes": "This pack is unusual: its 'target' is WP-CLI, not a WordPress plugin. WP-CLI is a PHP command-line tool that drives WordPress core through its own PHP APIs. Agents are fluent in WP-CLI and reach for it constantly, but it fails when the host has no `wp` binary, when proc_open/shell_exec are disabled, or when the MCP server cannot shell out — exactly the situation the built-in agent-connector-for-wp/wp-cli ability hits and cannot recover from. This pack reimplements the WP-CLI command surface in NATIVE PHP using WordPress core functions and $wpdb, so every command works with zero shell access. Ability names mirror WP-CLI verbatim (wp-cli/option-get == `wp option get`, wp-cli/post-create == `wp post create`) so an agent that thinks in WP-CLI maps to abilities 1:1. The 'source of truth' here is WP-CLI's documented command semantics (verified against WP-CLI 2.12.0) plus WordPress core's own load/save paths, which the abilities persist through so core validation and hooks still run. SANDBOX NOTES: WordPress runs in a separate container (ABSPATH /var/www/html) from the workspace shell mount (/home/node/wp) — file-path inputs (media-import, db-export file_path) must use the container path. Network IS reachable in this sandbox, so install/update/checksum abilities were verified live. Multisite is out of scope."
  },
  "surfaces": [
    { "id": "cmd-option", "kind": "cli", "ref": "wp option (WP-CLI Option_Command)", "detail": { "abilities": ["option-get","option-add","option-update","option-delete","option-list","option-pluck","option-patch","option-get-autoload","option-set-autoload"], "core_apis": ["get_option","add_option","update_option","delete_option","wp_set_option_autoload","$wpdb->options"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-post", "kind": "cli", "ref": "wp post + wp post-meta + wp post-term", "detail": { "abilities": ["post-get","post-list","post-create","post-update","post-delete","post-exists","post-generate","post-meta-get","post-meta-list","post-meta-add","post-meta-update","post-meta-delete","post-term-list","post-term-set","post-term-add","post-term-remove"], "core_apis": ["wp_insert_post","wp_update_post","wp_delete_post","WP_Query","get_post","*_post_meta","wp_set_object_terms"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-post-type", "kind": "cli", "ref": "wp post-type", "detail": { "abilities": ["post-type-list","post-type-get"], "core_apis": ["get_post_types","get_post_type_object"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-user", "kind": "cli", "ref": "wp user + wp user-meta", "detail": { "abilities": ["user-get","user-list","user-create","user-update","user-delete","user-exists","user-generate","user-set-role","user-add-role","user-remove-role","user-list-caps","user-add-cap","user-remove-cap","user-reset-password","user-session-list","user-session-destroy","user-meta-get","user-meta-list","user-meta-add","user-meta-update","user-meta-delete"], "core_apis": ["wp_insert_user","wp_update_user","wp_delete_user","get_users","WP_User","WP_Session_Tokens","*_user_meta"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-role-cap", "kind": "cli", "ref": "wp role + wp cap", "detail": { "abilities": ["role-list","role-get","role-create","role-delete","role-exists","role-reset","cap-list","cap-add","cap-remove"], "core_apis": ["get_role","add_role","remove_role","wp_roles","populate_roles","WP_Role::add_cap/remove_cap"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-term", "kind": "cli", "ref": "wp term + wp term-meta", "detail": { "abilities": ["term-get","term-list","term-create","term-update","term-delete","term-exists","term-recount","term-generate","term-meta-get","term-meta-list","term-meta-add","term-meta-update","term-meta-delete"], "core_apis": ["get_term","get_terms","wp_insert_term","wp_update_term","wp_delete_term","wp_update_term_count_now","*_term_meta"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-taxonomy", "kind": "cli", "ref": "wp taxonomy", "detail": { "abilities": ["taxonomy-list","taxonomy-get"], "core_apis": ["get_taxonomies","get_taxonomy"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-comment", "kind": "cli", "ref": "wp comment + wp comment-meta", "detail": { "abilities": ["comment-get","comment-list","comment-create","comment-update","comment-delete","comment-exists","comment-generate","comment-approve","comment-unapprove","comment-spam","comment-unspam","comment-trash","comment-untrash","comment-status","comment-count","comment-recount","comment-meta-get","comment-meta-list","comment-meta-add","comment-meta-update","comment-meta-delete"], "core_apis": ["get_comment","get_comments","wp_insert_comment","wp_update_comment","wp_set_comment_status","wp_count_comments","wp_update_comment_count","*_comment_meta"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-plugin", "kind": "cli", "ref": "wp plugin", "detail": { "abilities": ["plugin-list","plugin-get","plugin-is-active","plugin-is-installed","plugin-status","plugin-path","plugin-activate","plugin-deactivate","plugin-toggle","plugin-delete","plugin-install","plugin-update","plugin-auto-updates-status","plugin-auto-updates-enable","plugin-auto-updates-disable"], "core_apis": ["get_plugins","activate_plugin","deactivate_plugins","delete_plugins","Plugin_Upgrader","plugins_api"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-theme", "kind": "cli", "ref": "wp theme + wp theme mod", "detail": { "abilities": ["theme-list","theme-get","theme-is-active","theme-is-installed","theme-status","theme-path","theme-activate","theme-delete","theme-install","theme-update","theme-mod-get","theme-mod-get-all","theme-mod-set","theme-mod-remove","theme-auto-updates-status","theme-auto-updates-enable","theme-auto-updates-disable"], "core_apis": ["wp_get_themes","switch_theme","delete_theme","Theme_Upgrader","themes_api","*_theme_mod"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-language", "kind": "cli", "ref": "wp language core", "detail": { "abilities": ["language-core-list","language-core-install","language-core-activate","language-core-uninstall","language-core-update","language-list"], "core_apis": ["wp_get_available_translations","wp_download_language_pack","get_available_languages","update_option('WPLANG')"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-menu", "kind": "cli", "ref": "wp menu", "detail": { "abilities": ["menu-list","menu-create","menu-delete","menu-item-list","menu-item-add-post","menu-item-add-term","menu-item-add-custom","menu-item-delete","menu-location-list","menu-location-assign","menu-location-remove"], "core_apis": ["wp_get_nav_menus","wp_create_nav_menu","wp_update_nav_menu_item","get_nav_menu_locations"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-widget-sidebar", "kind": "cli", "ref": "wp widget + wp sidebar", "detail": { "abilities": ["sidebar-list","widget-list","widget-add","widget-update","widget-delete","widget-move","widget-deactivate","widget-reset"], "core_apis": ["wp_get_sidebars_widgets","wp_set_sidebars_widgets","$wp_registered_sidebars","widget_<base> options"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-media", "kind": "cli", "ref": "wp media", "detail": { "abilities": ["media-import","media-list","media-regenerate","media-delete"], "core_apis": ["media_handle_sideload","download_url","wp_generate_attachment_metadata","wp_delete_attachment"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-option-data", "kind": "cli", "ref": "wp cache + wp transient", "detail": { "abilities": ["cache-get","cache-set","cache-add","cache-replace","cache-delete","cache-incr","cache-decr","cache-flush","cache-flush-group","cache-type","cache-supports","transient-get","transient-set","transient-delete","transient-delete-all","transient-delete-expired","transient-type"], "core_apis": ["wp_cache_*","*_transient","$wpdb->options"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-db", "kind": "cli", "ref": "wp db + wp search-replace", "detail": { "abilities": ["db-query","db-tables","db-size","db-columns","db-optimize","db-repair","db-check","db-prefix","db-search","db-search-replace","db-export"], "core_apis": ["$wpdb","maybe_unserialize/maybe_serialize","SHOW/CREATE TABLE"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-core", "kind": "cli", "ref": "wp core", "detail": { "abilities": ["core-version","core-check-update","core-is-installed","core-update-db","core-verify-checksums","core-check-extensions"], "core_apis": ["$wp_version","wp_version_check","wp_upgrade","api.wordpress.org checksums"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-cron", "kind": "cli", "ref": "wp cron", "detail": { "abilities": ["cron-event-list","cron-event-run","cron-event-schedule","cron-event-delete","cron-event-unschedule","cron-schedule-list","cron-test"], "core_apis": ["_get_cron_array","wp_schedule_event","wp_schedule_single_event","wp_unschedule_event","wp_get_schedules","spawn_cron"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-rewrite", "kind": "cli", "ref": "wp rewrite", "detail": { "abilities": ["rewrite-flush","rewrite-list","rewrite-structure"], "core_apis": ["$wp_rewrite","flush_rewrite_rules"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-config", "kind": "cli", "ref": "wp config", "detail": { "abilities": ["config-get","config-list","config-has","config-path","config-set","config-delete","config-shuffle-salts"], "core_apis": ["defined/constant","wp-config.php file parsing","api.wordpress.org salts"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-maintenance", "kind": "cli", "ref": "wp maintenance-mode", "detail": { "abilities": ["maintenance-mode-status","maintenance-mode-activate","maintenance-mode-deactivate"], "core_apis": ["ABSPATH/.maintenance file"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-site", "kind": "cli", "ref": "wp site (single-site subset)", "detail": { "abilities": ["site-url","site-info","site-empty"], "core_apis": ["get_option(siteurl/home)","$wpdb TRUNCATE"] }, "discovered_by": ["static","dynamic"] },
    { "id": "cmd-export-import", "kind": "cli", "ref": "wp export + wp import", "detail": { "abilities": ["export","import"], "core_apis": ["export_wp (WXR)","SimpleXML WXR parse","wp_insert_post/wp_insert_term"] }, "discovered_by": ["static","dynamic"] }
  ],
  "data_stores": [
    { "id": "store-options", "type": "option", "key_or_name": "wp_options", "schema": { "option_name": "string", "option_value": "mixed (serialized)", "autoload": "yes|no|on|off|auto-*" }, "load_path": "get_option()", "save_path": "add_option()/update_option()/delete_option()/wp_set_option_autoload()" },
    { "id": "store-posts", "type": "table", "key_or_name": "wp_posts", "load_path": "get_post()/WP_Query", "save_path": "wp_insert_post()/wp_update_post()/wp_delete_post()" },
    { "id": "store-postmeta", "type": "post_meta", "key_or_name": "wp_postmeta", "load_path": "get_post_meta()", "save_path": "add_post_meta()/update_post_meta()/delete_post_meta()" },
    { "id": "store-users", "type": "table", "key_or_name": "wp_users + wp_usermeta", "load_path": "get_user_by()/WP_User", "save_path": "wp_insert_user()/wp_update_user()/wp_delete_user()" },
    { "id": "store-terms", "type": "table", "key_or_name": "wp_terms + wp_term_taxonomy + wp_term_relationships + wp_termmeta", "load_path": "get_term()/get_terms()", "save_path": "wp_insert_term()/wp_update_term()/wp_delete_term()/wp_set_object_terms()" },
    { "id": "store-comments", "type": "table", "key_or_name": "wp_comments + wp_commentmeta", "load_path": "get_comment()/get_comments()", "save_path": "wp_insert_comment()/wp_update_comment()/wp_set_comment_status()" },
    { "id": "store-roles", "type": "option", "key_or_name": "wp_user_roles", "load_path": "wp_roles()/get_role()", "save_path": "WP_Role::add_cap()/remove_cap()/add_role()/remove_role()" },
    { "id": "store-theme-mods", "type": "option", "key_or_name": "theme_mods_<stylesheet>", "load_path": "get_theme_mod()/get_theme_mods()", "save_path": "set_theme_mod()/remove_theme_mod()" },
    { "id": "store-active-plugins", "type": "option", "key_or_name": "active_plugins / auto_update_plugins", "load_path": "get_plugins()/is_plugin_active()", "save_path": "activate_plugin()/deactivate_plugins()" },
    { "id": "store-sidebars", "type": "option", "key_or_name": "sidebars_widgets + widget_<base>", "load_path": "wp_get_sidebars_widgets()", "save_path": "wp_set_sidebars_widgets() + update_option(widget_<base>)" },
    { "id": "store-nav-menus", "type": "cpt", "key_or_name": "nav_menu_item posts + nav_menu taxonomy + theme_mod nav_menu_locations", "load_path": "wp_get_nav_menu_items()", "save_path": "wp_update_nav_menu_item()/set_theme_mod('nav_menu_locations')" },
    { "id": "store-cron", "type": "option", "key_or_name": "cron", "load_path": "_get_cron_array()", "save_path": "wp_schedule_event()/wp_unschedule_event()" },
    { "id": "store-transients", "type": "transient", "key_or_name": "_transient_* / object cache", "load_path": "get_transient()/wp_cache_get()", "save_path": "set_transient()/wp_cache_set()" },
    { "id": "store-wpconfig", "type": "other", "key_or_name": "wp-config.php (PHP constants file)", "load_path": "defined()/constant()", "save_path": "regex edit of the wp-config.php file" },
    { "id": "store-maintenance", "type": "other", "key_or_name": "ABSPATH/.maintenance file", "load_path": "file_exists()", "save_path": "file_put_contents()/unlink()" }
  ],
  "tasks": [
    { "id": "t-options", "verb": "manage-options", "description": "Read/write/list/patch site options and their autoload flag.", "surfaces": ["cmd-option"], "stores": ["store-options"] },
    { "id": "t-content", "verb": "manage-content", "description": "Create/edit/delete/list posts & pages, their meta, and their term assignments; generate test content.", "surfaces": ["cmd-post","cmd-post-type"], "stores": ["store-posts","store-postmeta","store-terms"] },
    { "id": "t-users", "verb": "manage-users", "description": "Create/edit/delete users, manage their roles/caps/meta/sessions, reset passwords.", "surfaces": ["cmd-user","cmd-role-cap"], "stores": ["store-users","store-roles"] },
    { "id": "t-taxonomy", "verb": "manage-taxonomies", "description": "Create/edit/delete terms and meta, recount, introspect taxonomies & post types.", "surfaces": ["cmd-term","cmd-taxonomy"], "stores": ["store-terms"] },
    { "id": "t-comments", "verb": "manage-comments", "description": "Create/moderate (approve/spam/trash)/edit/delete/count comments and their meta.", "surfaces": ["cmd-comment"], "stores": ["store-comments"] },
    { "id": "t-plugins", "verb": "manage-plugins", "description": "List/install/activate/deactivate/update/delete plugins and toggle auto-updates.", "surfaces": ["cmd-plugin"], "stores": ["store-active-plugins"] },
    { "id": "t-themes", "verb": "manage-themes", "description": "List/install/activate/update/delete themes; read/write theme mods; toggle auto-updates.", "surfaces": ["cmd-theme"], "stores": ["store-theme-mods"] },
    { "id": "t-languages", "verb": "manage-languages", "description": "List/install/activate/uninstall/update core translations.", "surfaces": ["cmd-language"], "stores": ["store-options"] },
    { "id": "t-appearance", "verb": "manage-appearance", "description": "Build nav menus & assign locations; place/move/remove widgets in sidebars.", "surfaces": ["cmd-menu","cmd-widget-sidebar"], "stores": ["store-nav-menus","store-sidebars"] },
    { "id": "t-media", "verb": "manage-media", "description": "Import files into the media library, list, regenerate thumbnails, delete.", "surfaces": ["cmd-media"], "stores": ["store-posts"] },
    { "id": "t-cache", "verb": "manage-cache", "description": "Read/write object cache and transients; flush; clear expired.", "surfaces": ["cmd-option-data"], "stores": ["store-transients"] },
    { "id": "t-database", "verb": "manage-database", "description": "Run SQL, inspect tables/size/columns, optimize/repair/check, search, serialization-safe search-replace, and a native SQL dump.", "surfaces": ["cmd-db"], "stores": ["store-posts","store-options"] },
    { "id": "t-core", "verb": "manage-core", "description": "Report/verify core version, check for updates, run the DB upgrade routine, verify checksums.", "surfaces": ["cmd-core"], "stores": [] },
    { "id": "t-cron", "verb": "manage-cron", "description": "List/schedule/run/unschedule/delete cron events; list schedules; test WP-Cron.", "surfaces": ["cmd-cron"], "stores": ["store-cron"] },
    { "id": "t-rewrite", "verb": "manage-rewrites", "description": "Flush rewrite rules, list them, get/set the permalink structure.", "surfaces": ["cmd-rewrite"], "stores": ["store-options"] },
    { "id": "t-config", "verb": "manage-wpconfig", "description": "Read/set/delete wp-config.php constants, list (redacted) config, rotate salts.", "surfaces": ["cmd-config"], "stores": ["store-wpconfig"] },
    { "id": "t-maintenance", "verb": "toggle-maintenance", "description": "Activate/deactivate/report maintenance mode.", "surfaces": ["cmd-maintenance"], "stores": ["store-maintenance"] },
    { "id": "t-site", "verb": "manage-site", "description": "Read/set site URL, summarize site info, empty all content.", "surfaces": ["cmd-site"], "stores": ["store-options","store-posts"] },
    { "id": "t-export-import", "verb": "transfer-content", "description": "Export content to WXR and import a WXR file/string.", "surfaces": ["cmd-export-import"], "stores": ["store-posts","store-terms"] }
  ]
}
