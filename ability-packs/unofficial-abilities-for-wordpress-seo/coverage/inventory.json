{
  "plugin": {
    "slug": "wordpress-seo",
    "version": "27.8",
    "main_file": "wordpress-seo/wp-seo.php",
    "notes": "Yoast SEO free. Yoast core already registers three read-only abilities (yoast-seo/get-seo-scores, get-readability-scores, get-inclusive-language-scores) via src/abilities/; this pack complements them with the write/control surface and does not duplicate them. Premium-only features (redirects, multiple keyphrases, internal-linking suggestions data) and integrations needing external services (SEMrush, Wincher, MyYoast, AI generation, IndexNow ping) are out of scope. Multisite is out of scope. The sandbox had never run Yoast indexing, so the wp_yoast_indexable table is empty and Yoast renders the head from postmeta/options directly — acceptance was confirmed against the rendered frontend and the DB."
  },
  "surfaces": [
    { "id": "metabox:post-seo", "kind": "post_meta", "ref": "inc/class-wpseo-meta.php WPSEO_Meta::$meta_fields", "detail": { "store": "_yoast_wpseo_* postmeta", "fields": "focuskw,title,metadesc,is_cornerstone,meta-robots-noindex,meta-robots-nofollow,meta-robots-adv,canonical,bctitle,opengraph-title/description/image/image-id,twitter-title/description/image/image-id,schema_page_type,schema_article_type" }, "discovered_by": ["static", "dynamic"] },
    { "id": "post_meta:primary-term", "kind": "post_meta", "ref": "inc/class-wpseo-primary-term.php / admin/class-primary-term-admin.php", "detail": { "key": "_yoast_wpseo_primary_<taxonomy>" }, "discovered_by": ["static", "dynamic"] },
    { "id": "metabox:term-seo", "kind": "term_meta", "ref": "inc/options/class-wpseo-taxonomy-meta.php WPSEO_Taxonomy_Meta", "detail": { "store": "option wpseo_taxonomy_meta[taxonomy][term_id]", "fields": "wpseo_title,wpseo_desc,wpseo_focuskw,wpseo_canonical,wpseo_bctitle,wpseo_noindex,wpseo_is_cornerstone,wpseo_opengraph-*,wpseo_twitter-*" }, "discovered_by": ["static", "dynamic"] },
    { "id": "admin_page:search-appearance", "kind": "option", "ref": "inc/options/class-wpseo-option-titles.php (option wpseo_titles)", "detail": { "keys": "separator, title-<pt>, metadesc-<pt>, noindex-<pt>, schema-page-type-<pt>, schema-article-type-<pt>, social-*-<pt>, title-tax-<tax>, metadesc-tax-<tax>, noindex-tax-<tax>, title-home-wpseo, title-author/archive/search/404-wpseo, breadcrumbs-*, company_or_person, company_name/logo, person_name, website_name, org-*" }, "discovered_by": ["static", "dynamic"] },
    { "id": "admin_page:social", "kind": "option", "ref": "inc/options/class-wpseo-option-social.php (option wpseo_social)", "detail": { "keys": "opengraph, twitter, twitter_card_type, facebook_site, twitter_site, instagram_url, linkedin_url, youtube_url, pinterest_url, wikipedia_url, mastodon_url, other_social_urls, og_default_image(_id), og_frontpage_title/desc/image(_id), pinterestverify" }, "discovered_by": ["static", "dynamic"] },
    { "id": "admin_page:general-settings", "kind": "option", "ref": "inc/options/class-wpseo-option-wpseo.php (option wpseo)", "detail": { "keys": "enable_xml_sitemap, enable_cornerstone_content, enable_admin_bar_menu, enable_text_link_counter, enable_index_now, enable_llms_txt, enable_schema, keyword_analysis_active, content_analysis_active, inclusive_language_analysis_active, disableadvanced_meta, tracking, baiduverify/googleverify/msverify/yandexverify, site_type, environment_type, company_or_person, remove_*/deny_*_crawling" }, "discovered_by": ["static", "dynamic"] },
    { "id": "api:options-facade", "kind": "other", "ref": "inc/options/class-wpseo-options.php WPSEO_Options::get/get_option/set/save_option", "detail": { "role": "validated read/write facade for all option groups" }, "discovered_by": ["static"] },
    { "id": "api:replacement-vars", "kind": "other", "ref": "inc/class-wpseo-replace-vars.php WPSEO_Replace_Vars::get_replacement_variables_list", "detail": { "role": "list %%vars%% valid in title/metadesc templates" }, "discovered_by": ["static", "dynamic"] },
    { "id": "table:indexable", "kind": "table", "ref": "wp_yoast_indexable + src/integrations/watchers/*; src/builders/*", "detail": { "role": "rendering source of truth; rebuilt from postmeta on shutdown (posts) and from edited_term/forced rebuild (terms)" }, "discovered_by": ["static", "dynamic"] },
    { "id": "abilities:yoast-core", "kind": "other", "ref": "src/abilities/user-interface/abilities-integration.php", "detail": { "registers": "yoast-seo/get-seo-scores, get-readability-scores, get-inclusive-language-scores (read-only)" }, "discovered_by": ["static", "dynamic"] },
    { "id": "tools:import-export", "kind": "admin_page", "ref": "admin/import/ + Import_Settings", "detail": { "role": "import/export Yoast settings as a blob" }, "discovered_by": ["static"] },
    { "id": "tools:file-editor", "kind": "admin_page", "ref": "admin/views/tool-file-editor.php", "detail": { "role": "edit robots.txt / .htaccess" }, "discovered_by": ["static"] },
    { "id": "tools:bulk-editor", "kind": "admin_page", "ref": "admin/class-bulk-editor-list-table.php", "detail": { "role": "bulk edit titles/descriptions" }, "discovered_by": ["static"] },
    { "id": "feature:redirects", "kind": "admin_page", "ref": "Premium only", "detail": { "role": "URL redirect manager" }, "discovered_by": ["static"] },
    { "id": "feature:integrations", "kind": "rest_route", "ref": "src/routes/{semrush,wincher,first-time-configuration,workouts,importing}-route.php", "detail": { "role": "SEMrush/Wincher/AI/onboarding — need external services or Premium" }, "discovered_by": ["static"] }
  ],
  "data_stores": [
    { "id": "postmeta-seo", "type": "post_meta", "key_or_name": "_yoast_wpseo_*", "schema": { "prefix": "_yoast_wpseo_", "noindex": "0=default,1=noindex,2=index", "robots-adv": "csv of noimageindex,noarchive,nosnippet", "is_cornerstone": "1/''" }, "load_path": "WPSEO_Meta::get_value(key,post_id)", "save_path": "WPSEO_Meta::set_value(key,value,post_id)" },
    { "id": "postmeta-primary-term", "type": "post_meta", "key_or_name": "_yoast_wpseo_primary_<taxonomy>", "schema": { "value": "term_id" }, "load_path": "get_post_meta", "save_path": "update_post_meta (not part of WPSEO_Meta)" },
    { "id": "option-taxonomy-meta", "type": "option", "key_or_name": "wpseo_taxonomy_meta", "schema": { "shape": "[taxonomy][term_id][wpseo_<key>]", "noindex": "default|index|noindex", "stored": "non-default values only" }, "load_path": "WPSEO_Taxonomy_Meta::get_term_meta(term,taxonomy[,key])", "save_path": "WPSEO_Taxonomy_Meta::set_values(term_id,taxonomy,FULL_meta_array) — must pass the full set or absent text/social fields reset to default" },
    { "id": "option-titles", "type": "option", "key_or_name": "wpseo_titles", "schema": { "owner": "WPSEO_Option_Titles", "dynamic_keys": "per public post type & taxonomy via enrich_defaults()", "patterns": "title-,metadesc-,noindex-,schema-page-type-,schema-article-type-,social-*-,org-,...", "separator": "key like sc-dash (not the char)" }, "load_path": "WPSEO_Options::get_option('wpseo_titles')", "save_path": "WPSEO_Options::save_option('wpseo_titles',key,value)" },
    { "id": "option-social", "type": "option", "key_or_name": "wpseo_social", "schema": { "owner": "WPSEO_Option_Social", "twitter_card_type": "summary_large_image" }, "load_path": "WPSEO_Options::get_option('wpseo_social')", "save_path": "WPSEO_Options::save_option('wpseo_social',key,value)" },
    { "id": "option-wpseo", "type": "option", "key_or_name": "wpseo", "schema": { "owner": "WPSEO_Option_Wpseo", "note": "mix of user settings + internal state; pack exposes a curated subset" }, "load_path": "WPSEO_Options::get_option('wpseo')", "save_path": "WPSEO_Options::save_option('wpseo',key,value)" },
    { "id": "table-indexable", "type": "table", "key_or_name": "wp_yoast_indexable", "schema": { "role": "denormalized SEO per object for rendering" }, "load_path": "Indexable_Repository", "save_path": "Indexable_Builder via watchers (post: shutdown; term: forced rebuild after set_values)" }
  ],
  "tasks": [
    { "id": "t-find", "verb": "find-content", "description": "Discover posts/pages or taxonomy terms and their SEO summary to locate an id.", "surfaces": ["metabox:post-seo", "metabox:term-seo"], "stores": ["postmeta-seo", "option-taxonomy-meta"] },
    { "id": "t-get-content", "verb": "get-content-seo", "description": "Read the full Yoast SEO metadata for one post or term.", "surfaces": ["metabox:post-seo", "metabox:term-seo", "post_meta:primary-term"], "stores": ["postmeta-seo", "option-taxonomy-meta", "postmeta-primary-term"] },
    { "id": "t-set-focuskw", "verb": "set-focus-keyphrase", "description": "Set the focus keyphrase on a post or term.", "surfaces": ["metabox:post-seo", "metabox:term-seo"], "stores": ["postmeta-seo", "option-taxonomy-meta"] },
    { "id": "t-set-title-desc", "verb": "set-seo-title-and-description", "description": "Set the SEO title and meta description (with replacement variables) on a post or term.", "surfaces": ["metabox:post-seo", "metabox:term-seo"], "stores": ["postmeta-seo", "option-taxonomy-meta"] },
    { "id": "t-set-robots", "verb": "set-robots", "description": "Set noindex/index/default, nofollow, and advanced robots (noimageindex/noarchive/nosnippet).", "surfaces": ["metabox:post-seo", "metabox:term-seo"], "stores": ["postmeta-seo", "option-taxonomy-meta"] },
    { "id": "t-set-canonical", "verb": "set-canonical", "description": "Set a canonical URL override.", "surfaces": ["metabox:post-seo", "metabox:term-seo"], "stores": ["postmeta-seo", "option-taxonomy-meta"] },
    { "id": "t-set-cornerstone", "verb": "set-cornerstone", "description": "Flag a post or term as cornerstone content.", "surfaces": ["metabox:post-seo", "metabox:term-seo"], "stores": ["postmeta-seo", "option-taxonomy-meta"] },
    { "id": "t-set-social", "verb": "set-social-overrides", "description": "Set per-content Open Graph and X/Twitter title/description/image.", "surfaces": ["metabox:post-seo", "metabox:term-seo"], "stores": ["postmeta-seo", "option-taxonomy-meta"] },
    { "id": "t-set-breadcrumb", "verb": "set-breadcrumb-title", "description": "Set the breadcrumb title for a post or term.", "surfaces": ["metabox:post-seo", "metabox:term-seo"], "stores": ["postmeta-seo", "option-taxonomy-meta"] },
    { "id": "t-set-schema", "verb": "set-schema-types", "description": "Set the schema page type and article type for a post.", "surfaces": ["metabox:post-seo"], "stores": ["postmeta-seo"] },
    { "id": "t-set-primary-term", "verb": "set-primary-term", "description": "Set the primary term for a hierarchical taxonomy on a post.", "surfaces": ["post_meta:primary-term"], "stores": ["postmeta-primary-term"] },
    { "id": "t-get-search-appearance", "verb": "read-search-appearance", "description": "Read title/metadesc templates, separator, special pages, breadcrumbs, knowledge graph, per-type schema/noindex.", "surfaces": ["admin_page:search-appearance"], "stores": ["option-titles"] },
    { "id": "t-set-title-templates", "verb": "set-title-and-metadesc-templates", "description": "Set per-post-type / per-taxonomy / homepage / special-page title and meta description templates.", "surfaces": ["admin_page:search-appearance"], "stores": ["option-titles"] },
    { "id": "t-set-separator", "verb": "set-title-separator", "description": "Set the title separator (sc-* key).", "surfaces": ["admin_page:search-appearance"], "stores": ["option-titles"] },
    { "id": "t-set-archive-noindex", "verb": "set-content-type-indexing", "description": "Toggle noindex for a post type, taxonomy, or special archive.", "surfaces": ["admin_page:search-appearance"], "stores": ["option-titles"] },
    { "id": "t-set-schema-defaults", "verb": "set-schema-defaults", "description": "Set default schema page/article type per post type.", "surfaces": ["admin_page:search-appearance"], "stores": ["option-titles"] },
    { "id": "t-set-breadcrumbs", "verb": "configure-breadcrumbs", "description": "Enable breadcrumbs and set separator/home/prefix text.", "surfaces": ["admin_page:search-appearance"], "stores": ["option-titles"] },
    { "id": "t-set-knowledge-graph", "verb": "set-site-representation", "description": "Set organization vs person, company/person name and logo, website name.", "surfaces": ["admin_page:search-appearance"], "stores": ["option-titles"] },
    { "id": "t-read-social", "verb": "read-social-settings", "description": "Read social toggles, card type, profile URLs, default/front-page images.", "surfaces": ["admin_page:social"], "stores": ["option-social"] },
    { "id": "t-set-social-settings", "verb": "set-social-settings", "description": "Set social profiles, default image, front-page OG, card type, toggles.", "surfaces": ["admin_page:social"], "stores": ["option-social"] },
    { "id": "t-read-general", "verb": "read-general-settings", "description": "Read feature toggles, verification codes, site identity, crawl cleanup.", "surfaces": ["admin_page:general-settings"], "stores": ["option-wpseo"] },
    { "id": "t-set-features", "verb": "toggle-features", "description": "Enable/disable XML sitemap, cornerstone, analyses, IndexNow, llms.txt, etc.", "surfaces": ["admin_page:general-settings"], "stores": ["option-wpseo"] },
    { "id": "t-set-verification", "verb": "set-webmaster-verification", "description": "Set Google/Bing/Baidu/Yandex verification codes.", "surfaces": ["admin_page:general-settings"], "stores": ["option-wpseo"] },
    { "id": "t-set-crawl-cleanup", "verb": "configure-crawl-cleanup", "description": "Toggle feed/link/header cleanup and crawler-deny options.", "surfaces": ["admin_page:general-settings"], "stores": ["option-wpseo"] },
    { "id": "t-list-vars", "verb": "list-replacement-variables", "description": "List the replacement variables usable in title/metadesc templates.", "surfaces": ["api:replacement-vars"], "stores": [] }
  ]
}
