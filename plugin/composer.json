{
	"name": "soflyy/agent-connector-for-wp",
	"description": "Give agents unrestricted execution capability on WordPress: shell, PHP eval, filesystem, and process execution exposed through the WordPress MCP stack. Dev only.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": ["wordpress", "mcp", "ai", "agents", "abilities"],
	"homepage": "https://github.com/soflyy/agent-connector-for-wp",
	"require": {
		"php": ">=8.1",
		"automattic/jetpack-autoloader": "^5.0",
		"wordpress/mcp-adapter": "^0.6",
		"yahnis-elsts/plugin-update-checker": "^5.7"
	},
	"autoload": {
		"psr-4": {
			"AgentConnectorForWp\\": "src/"
		}
	},
	"scripts": {
		"test": [
			"@php tests/directory.php",
			"bash tests/manifest.sh"
		],
		"lint": [
			"@php -l agent-connector-for-wp.php",
			"find src tests examples -name '*.php' -print0 | xargs -0 -n1 php -l"
		]
	},
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true
		},
		"sort-packages": true
	},
	"minimum-stability": "stable"
}
