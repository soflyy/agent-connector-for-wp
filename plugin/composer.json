{
	"name": "soflyy/agent-connector-for-wp",
	"description": "A secured MCP server that exposes the WordPress Abilities other plugins register to AI agents, with admin authentication, a domain lock, and audit logging.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": ["wordpress", "mcp", "ai", "agents", "abilities"],
	"homepage": "https://github.com/soflyy/agent-connector-for-wp",
	"require": {
		"php": ">=8.1",
		"automattic/jetpack-autoloader": "^5.0",
		"wordpress/mcp-adapter": "^0.5"
	},
	"autoload": {
		"psr-4": {
			"AgentConnectorForWp\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true
		},
		"sort-packages": true
	},
	"minimum-stability": "stable"
}
