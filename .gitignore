# Composer dependencies — installed via `composer install`, bundled into the
# release zip by CI (see .github/workflows/release.yml). composer.lock IS
# tracked so builds are reproducible.
/plugin/vendor/

# Node dependencies for the admin React app — installed via `npm install`,
# never committed (the built bundle in plugin/admin/build/ IS tracked).
node_modules/

# Build artifacts
/plugin/dist/
/dist/
*.zip

# Runtime artifacts
agent-connector-for-wp-audit.log
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local agent worktrees / session state
.claude/
