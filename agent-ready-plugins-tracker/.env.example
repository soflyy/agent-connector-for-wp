# Site password gate
# SITE_PASSWORD — the password users must enter
# AUTH_TOKEN_HASH — any random secret string (used as the cookie value)
#   Generate one: openssl rand -hex 32
SITE_PASSWORD=
AUTH_TOKEN_HASH=

# Supabase — Settings → API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# Protect the seed and admin API routes
SEED_SECRET=
ADMIN_SECRET=

# Ability-pack manifest source for /api/ability-packs/match (optional).
# Defaults to the agent-connector-for-wp repo's stable pack-index release asset:
#   https://github.com/soflyy/agent-connector-for-wp/releases/download/pack-index/index.json
PACK_INDEX_URL=
