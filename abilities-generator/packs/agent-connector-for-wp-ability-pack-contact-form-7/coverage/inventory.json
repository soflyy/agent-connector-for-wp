{
  "plugin": {
    "slug": "contact-form-7",
    "version": "6.1.6",
    "main_file": "contact-form-7/wp-contact-form-7.php",
    "notes": "Forms are a CPT (wpcf7_contact_form) whose configuration lives in post meta. Contact Form 7 does NOT store submissions itself — submission storage is provided by the separate Flamingo plugin (out of scope for this pack). Third-party integrations (reCAPTCHA, Turnstile, Brevo/Sendinblue, Stripe, Constant Contact) require external API keys/OAuth and cannot be exercised in the sandbox; they are excluded. Multisite out of scope."
  },
  "surfaces": [
    { "id": "cpt:wpcf7_contact_form", "kind": "cpt", "ref": "includes/contact-form.php:8 (WPCF7_ContactForm::post_type)", "detail": { "post_title": "form title", "post_name": "slug" }, "discovered_by": ["static", "dynamic"] },
    { "id": "post_meta:_form", "kind": "post_meta", "ref": "includes/contact-form.php construct_properties", "detail": { "type": "string", "desc": "form template with [form-tags]" }, "discovered_by": ["static", "dynamic"] },
    { "id": "post_meta:_mail", "kind": "post_meta", "ref": "includes/contact-form-template.php mail()", "detail": { "type": "array", "keys": "active,recipient,sender,subject,body,additional_headers,attachments,use_html,exclude_blank" }, "discovered_by": ["static", "dynamic"] },
    { "id": "post_meta:_mail_2", "kind": "post_meta", "ref": "includes/contact-form-template.php mail_2()", "detail": { "type": "array", "desc": "optional autoresponder; has 'active' flag" }, "discovered_by": ["static", "dynamic"] },
    { "id": "post_meta:_messages", "kind": "post_meta", "ref": "includes/contact-form-template.php wpcf7_messages()", "detail": { "type": "array", "desc": "status key => response text" }, "discovered_by": ["static", "dynamic"] },
    { "id": "post_meta:_additional_settings", "kind": "post_meta", "ref": "includes/contact-form.php additional_setting()", "detail": { "type": "string", "desc": "newline-separated key: value lines" }, "discovered_by": ["static", "dynamic"] },
    { "id": "post_meta:_locale", "kind": "post_meta", "ref": "includes/contact-form.php:215", "discovered_by": ["static"] },
    { "id": "post_meta:_hash", "kind": "post_meta", "ref": "includes/contact-form.php:216 / wpcf7_generate_contact_form_hash", "detail": { "desc": "sha256, used by [contact-form-7 id=\"<hash>\"] shortcode lookup" }, "discovered_by": ["static", "dynamic"] },
    { "id": "admin_page:wpcf7", "kind": "admin_page", "ref": "admin/admin.php:10-76", "detail": { "desc": "Contact Forms list + editor" }, "discovered_by": ["static"] },
    { "id": "admin_page:wpcf7-new", "kind": "admin_page", "ref": "admin/admin.php", "detail": { "desc": "Add New form" }, "discovered_by": ["static"] },
    { "id": "admin_page:wpcf7-integration", "kind": "admin_page", "ref": "admin/admin.php / includes/integration.php", "detail": { "desc": "Third-party service integration (API keys/OAuth)" }, "discovered_by": ["static"] },
    { "id": "admin_action:save", "kind": "ajax_action", "ref": "admin/admin.php:238-289 wpcf7_save_contact_form", "discovered_by": ["static"] },
    { "id": "admin_action:copy", "kind": "ajax_action", "ref": "admin/admin.php:291-316 WPCF7_ContactForm::copy", "discovered_by": ["static"] },
    { "id": "admin_action:delete", "kind": "ajax_action", "ref": "admin/admin.php:318-366 WPCF7_ContactForm::delete", "discovered_by": ["static"] },
    { "id": "admin_action:validate", "kind": "ajax_action", "ref": "admin/admin.php:415-419 bulk config validation", "discovered_by": ["static"] },
    { "id": "rest_route:/contact-form-7/v1/contact-forms", "kind": "rest_route", "ref": "includes/rest-api.php", "detail": { "methods": "GET (list), POST (create)" }, "discovered_by": ["static"] },
    { "id": "rest_route:/contact-form-7/v1/contact-forms/<id>", "kind": "rest_route", "ref": "includes/rest-api.php", "detail": { "methods": "GET, POST/PUT (update), DELETE" }, "discovered_by": ["static"] },
    { "id": "rest_route:/contact-form-7/v1/contact-forms/<id>/feedback", "kind": "rest_route", "ref": "includes/rest-api.php create_feedback", "detail": { "methods": "POST (submit), public" }, "discovered_by": ["static", "dynamic"] },
    { "id": "rest_route:/contact-form-7/v1/contact-forms/<id>/refill", "kind": "rest_route", "ref": "includes/rest-api.php", "detail": { "methods": "GET (dynamic refill)" }, "discovered_by": ["static"] },
    { "id": "shortcode:contact-form-7", "kind": "shortcode", "ref": "includes/contact-form-functions.php:226 wpcf7_contact_form_tag_func", "discovered_by": ["static", "dynamic"] },
    { "id": "block:contact-form-7/contact-form-selector", "kind": "block", "ref": "includes/block-editor/block-editor.php", "detail": { "desc": "Gutenberg block; thin wrapper over the shortcode" }, "discovered_by": ["static"] },
    { "id": "form_tags:registry", "kind": "hook", "ref": "includes/form-tags-manager.php / modules/*.php (wpcf7_add_form_tag)", "detail": { "types": "text,email,url,tel,textarea,select,checkbox,radio,acceptance,file,date,number,range,quiz,hidden,submit,reset,captchac,captchar,count,response,reflection" }, "discovered_by": ["static", "dynamic"] },
    { "id": "special_mail_tags", "kind": "hook", "ref": "includes/special-mail-tags.php", "detail": { "tags": "[_site_title],[_site_url],[_site_admin_email],[_remote_ip],[_user_agent],[_url],[_date],[_time],[_invalid_fields],[_post_id],[_post_title],[_user_email]..." }, "discovered_by": ["static", "dynamic"] },
    { "id": "config_validator", "kind": "other", "ref": "includes/config-validator/validator.php WPCF7_ConfigValidator", "detail": { "desc": "validates form/mail/messages/additional_settings; error codes incl dots_in_names, invalid_mailbox_syntax, maybe_empty" }, "discovered_by": ["static", "dynamic"] },
    { "id": "submission_pipeline", "kind": "other", "ref": "includes/submission.php WPCF7_Submission + contact-form.php submit()", "detail": { "desc": "validate -> acceptance -> spam -> mail; statuses mail_sent/validation_failed/acceptance_missing/spam/aborted/mail_failed" }, "discovered_by": ["static", "dynamic"] },
    { "id": "capability:wpcf7_edit_contact_forms", "kind": "capability", "ref": "includes/capabilities.php", "detail": { "desc": "edit/read/delete contact forms; mapped to manage_options. Submission cap wpcf7_submit -> read." }, "discovered_by": ["static"] },
    { "id": "module:flamingo", "kind": "hook", "ref": "modules/flamingo.php", "detail": { "desc": "Stores submissions into the separate Flamingo plugin when present. CF7 stores no submissions itself." }, "discovered_by": ["static"] },
    { "id": "module:integrations", "kind": "other", "ref": "includes/integration.php + modules/{recaptcha,turnstile,sendinblue,stripe,constant-contact}", "detail": { "desc": "External services requiring API keys/OAuth." }, "discovered_by": ["static"] }
  ],
  "data_stores": [
    { "id": "store:form", "type": "post_meta", "key_or_name": "_form", "schema": { "type": "string" }, "load_path": "WPCF7_ContactForm::prop('form')", "save_path": "wpcf7_save_contact_form(['id','form']) -> wpcf7_sanitize_form -> save()" },
    { "id": "store:mail", "type": "post_meta", "key_or_name": "_mail", "schema": { "active": "bool", "recipient": "string", "sender": "string", "subject": "string", "body": "string", "additional_headers": "string", "attachments": "string", "use_html": "bool", "exclude_blank": "bool" }, "load_path": "WPCF7_ContactForm::prop('mail')", "save_path": "wpcf7_save_contact_form(['id','mail']) -> wpcf7_sanitize_mail (forces active=true) -> save()" },
    { "id": "store:mail_2", "type": "post_meta", "key_or_name": "_mail_2", "schema": { "active": "bool", "...": "same as mail" }, "load_path": "WPCF7_ContactForm::prop('mail_2')", "save_path": "wpcf7_save_contact_form(['id','mail_2'])" },
    { "id": "store:messages", "type": "post_meta", "key_or_name": "_messages", "schema": { "<status_key>": "string" }, "load_path": "WPCF7_ContactForm::prop('messages')", "save_path": "wpcf7_save_contact_form(['id','messages']) -> wpcf7_sanitize_messages (keeps only wpcf7_messages() keys)" },
    { "id": "store:additional_settings", "type": "post_meta", "key_or_name": "_additional_settings", "schema": { "type": "string", "format": "key: value lines" }, "load_path": "WPCF7_ContactForm::additional_setting()/prop('additional_settings')", "save_path": "wpcf7_save_contact_form(['id','additional_settings'])" },
    { "id": "store:title_locale", "type": "cpt", "key_or_name": "post_title / _locale", "load_path": "WPCF7_ContactForm::title()/locale()", "save_path": "wpcf7_save_contact_form(['id','title','locale'])" }
  ],
  "tasks": [
    { "id": "t-list", "verb": "list-forms", "description": "Enumerate forms to find one to act on.", "surfaces": ["cpt:wpcf7_contact_form", "admin_page:wpcf7"], "stores": ["store:title_locale"] },
    { "id": "t-read", "verb": "get-form", "description": "Read a form's full configuration before editing.", "surfaces": ["admin_page:wpcf7"], "stores": ["store:form", "store:mail", "store:mail_2", "store:messages", "store:additional_settings"] },
    { "id": "t-create", "verb": "create-form", "description": "Create a new form (default starter or blank).", "surfaces": ["admin_page:wpcf7-new", "admin_action:save"], "stores": ["store:title_locale", "store:form", "store:mail"] },
    { "id": "t-copy", "verb": "copy-form", "description": "Duplicate a form.", "surfaces": ["admin_action:copy"], "stores": ["store:form", "store:mail"] },
    { "id": "t-delete", "verb": "delete-form", "description": "Delete a form.", "surfaces": ["admin_action:delete"], "stores": ["cpt:wpcf7_contact_form"] },
    { "id": "t-rename", "verb": "update-form-properties", "description": "Rename a form / change its locale.", "surfaces": ["admin_action:save"], "stores": ["store:title_locale"] },
    { "id": "t-add-field", "verb": "add-field", "description": "Add a form field (delta).", "surfaces": ["form_tags:registry", "admin_action:save"], "stores": ["store:form"] },
    { "id": "t-update-field", "verb": "update-field", "description": "Change an existing field (delta merge).", "surfaces": ["form_tags:registry"], "stores": ["store:form"] },
    { "id": "t-remove-field", "verb": "remove-field", "description": "Remove a field.", "surfaces": ["form_tags:registry"], "stores": ["store:form"] },
    { "id": "t-set-template", "verb": "set-form-template", "description": "Replace the whole form template.", "surfaces": ["admin_action:save"], "stores": ["store:form"] },
    { "id": "t-list-field-types", "verb": "list-field-types", "description": "Discover valid field types/options.", "surfaces": ["form_tags:registry"], "stores": [] },
    { "id": "t-update-mail", "verb": "update-mail", "description": "Edit primary/secondary mail template (delta).", "surfaces": ["admin_action:save"], "stores": ["store:mail", "store:mail_2"] },
    { "id": "t-list-mail-tags", "verb": "list-mail-tags", "description": "Discover available mail-tags + special tags.", "surfaces": ["special_mail_tags", "form_tags:registry"], "stores": [] },
    { "id": "t-update-messages", "verb": "update-messages", "description": "Edit response messages (delta).", "surfaces": ["admin_action:save"], "stores": ["store:messages"] },
    { "id": "t-list-message-keys", "verb": "list-message-keys", "description": "Discover message keys + defaults.", "surfaces": [], "stores": ["store:messages"] },
    { "id": "t-update-settings", "verb": "update-additional-settings", "description": "Set/unset additional-settings keys (delta).", "surfaces": ["admin_action:save"], "stores": ["store:additional_settings"] },
    { "id": "t-list-settings", "verb": "list-additional-settings-keys", "description": "Discover well-known additional-settings keys.", "surfaces": [], "stores": ["store:additional_settings"] },
    { "id": "t-validate", "verb": "validate-form", "description": "Run the configuration validator.", "surfaces": ["config_validator"], "stores": [] },
    { "id": "t-submit", "verb": "submit-form", "description": "Test-submit a form through the real pipeline.", "surfaces": ["submission_pipeline", "rest_route:/contact-form-7/v1/contact-forms/<id>/feedback"], "stores": [] },
    { "id": "t-submissions", "verb": "list-submissions", "description": "Read stored submissions — EXCLUDED: CF7 stores none; provided by the separate Flamingo plugin.", "surfaces": ["module:flamingo"], "stores": [] },
    { "id": "t-integrations", "verb": "configure-integrations", "description": "Configure reCAPTCHA/Turnstile/Brevo/Stripe — EXCLUDED: external service API keys/OAuth, not reachable in sandbox.", "surfaces": ["module:integrations", "admin_page:wpcf7-integration"], "stores": [] }
  ]
}
